<?xml version="1.0" encoding="utf-8"?>
<!-- Малий віджет (2×2): одна дія, обрана в налаштуванні. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/flowi_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <FrameLayout
    android:layout_width="54dp"
    android:layout_height="54dp">

    <ImageView
      android:id="@+id/flowi_small_circle"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no" />

    <ImageView
      android:id="@+id/flowi_small_icon"
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:layout_gravity="center"
      android:importantForAccessibility="no" />
  </FrameLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/flowi_small_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="@color/flowi_widget_text"
    android:textSize="17sp"
    android:textStyle="bold" />
</LinearLayout>
