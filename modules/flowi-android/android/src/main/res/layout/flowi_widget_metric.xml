<?xml version="1.0" encoding="utf-8"?>
<!-- Віджет-показник (2×2): одне кільце, обране в налаштуванні. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/flowi_widget_bg"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="10dp">

  <FrameLayout
    android:id="@+id/flowi_metric_ring"
    android:layout_width="84dp"
    android:layout_height="84dp">

    <ImageView
      android:id="@+id/flowi_metric_img"
      android:background="@drawable/flowi_ring_track_9"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no" />

    <TextView
      android:id="@+id/flowi_metric_center"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:autoSizeMaxTextSize="17sp"
      android:autoSizeMinTextSize="8sp"
      android:autoSizeTextType="uniform"
      android:gravity="center"
      android:maxLines="1"
      android:padding="12dp"
      android:textColor="@color/flowi_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />

    <Chronometer
      android:id="@+id/flowi_metric_chrono"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="@color/flowi_widget_text"
      android:textSize="13sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </FrameLayout>

  <TextView
    android:id="@+id/flowi_metric_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:fontFamily="sans-serif-medium"
    android:maxLines="1"
    android:textColor="@color/flowi_widget_text"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/flowi_metric_caption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center_horizontal"
    android:maxLines="1"
    android:textColor="@color/flowi_widget_text_secondary"
    android:textSize="10sp" />
</LinearLayout>
