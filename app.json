{
  "expo": {
    "name": "Flowi",
    "slug": "f-tracking-app",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/logo_app.png",
    "scheme": "ftrackingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.casper3.f-tracking-app",
      "appleTeamId": "D28SUT8PH4",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:api.flowi.casperdev.site"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.casper3.f-tracking-app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#163A5F",
        "foregroundImage": "./assets/logo_app.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.casper3.ftrackingapp",
      "versionCode": 1,
      "permissions": [
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.flowi.casperdev.site",
              "path": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo_app.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo_app.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_app.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#163A5F",
          "dark": {
            "backgroundColor": "#163A5F"
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Flowi читає з Здоровʼя кроки, пульс і пульс спокою, сон і його фази, вагу, SpO₂ та дистанцію, щоб показувати їх у розділі «Здоровʼя».",
          "NSHealthUpdateUsageDescription": "Flowi не записує дані в Здоровʼя — лише читає.",
          "background": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Flowi використовує Face ID, щоб захистити ваші збережені дані входу."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flowi використовує камеру, щоб сканувати QR-наліпки на коробках і відкривати їхній вміст.",
          "microphonePermission": "Flowi записує звук зустрічі, лише коли ви натискаєте «Запис», щоб зберегти аудіо до цієї зустрічі.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flowi відкриває фото, щоб ви могли додати зображення коробок, речей і скріншоти до звернень.",
          "cameraPermission": "Flowi використовує камеру, щоб сфотографувати коробку чи річ і додати фото до її картки.",
          "microphonePermission": "Flowi записує звук зустрічі, лише коли ви натискаєте «Запис», щоб зберегти аудіо до цієї зустрічі."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Flowi записує звук зустрічі, лише коли ви натискаєте «Запис», щоб зберегти аудіо до цієї зустрічі."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@bacons/apple-targets",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
