<?xml version="1.0" encoding="utf-8"?>
<!-- Великий віджет (4×4): кільця дня (фінанси, кроки, завдання, час) + чотири дії. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/flowi_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Flowi"
      android:textColor="@color/flowi_widget_accent"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/flowi_header_today"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginLeft="6dp"
      android:fontFamily="sans-serif-medium"
      android:textColor="@color/flowi_widget_text_secondary"
      android:textSize="13sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/flowi_rings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal">
    <LinearLayout
      android:id="@+id/flowi_ring_cell_1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp">

        <ImageView
          android:id="@+id/flowi_ring_img_1"
          android:background="@drawable/flowi_ring_track_7"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no" />

        <TextView
          android:id="@+id/flowi_ring_center_1"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:autoSizeMaxTextSize="13sp"
          android:autoSizeMinTextSize="7sp"
          android:autoSizeTextType="uniform"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:maxLines="1"
          android:padding="9dp"
          android:textColor="@color/flowi_widget_text"
          android:textSize="12sp"
          android:textStyle="bold" />

        <Chronometer
          android:id="@+id/flowi_ring_chrono_1"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="@color/flowi_widget_text"
          android:textSize="11sp"
          android:textStyle="bold"
          android:visibility="gone" />
      </FrameLayout>

      <TextView
        android:id="@+id/flowi_ring_title_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/flowi_widget_text"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/flowi_ring_caption_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:textColor="@color/flowi_widget_text_secondary"
        android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/flowi_ring_cell_2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp">

        <ImageView
          android:id="@+id/flowi_ring_img_2"
          android:background="@drawable/flowi_ring_track_7"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no" />

        <TextView
          android:id="@+id/flowi_ring_center_2"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:autoSizeMaxTextSize="13sp"
          android:autoSizeMinTextSize="7sp"
          android:autoSizeTextType="uniform"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:maxLines="1"
          android:padding="9dp"
          android:textColor="@color/flowi_widget_text"
          android:textSize="12sp"
          android:textStyle="bold" />

        <Chronometer
          android:id="@+id/flowi_ring_chrono_2"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="@color/flowi_widget_text"
          android:textSize="11sp"
          android:textStyle="bold"
          android:visibility="gone" />
      </FrameLayout>

      <TextView
        android:id="@+id/flowi_ring_title_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/flowi_widget_text"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/flowi_ring_caption_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:textColor="@color/flowi_widget_text_secondary"
        android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/flowi_ring_cell_3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp">

        <ImageView
          android:id="@+id/flowi_ring_img_3"
          android:background="@drawable/flowi_ring_track_7"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no" />

        <TextView
          android:id="@+id/flowi_ring_center_3"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:autoSizeMaxTextSize="13sp"
          android:autoSizeMinTextSize="7sp"
          android:autoSizeTextType="uniform"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:maxLines="1"
          android:padding="9dp"
          android:textColor="@color/flowi_widget_text"
          android:textSize="12sp"
          android:textStyle="bold" />

        <Chronometer
          android:id="@+id/flowi_ring_chrono_3"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="@color/flowi_widget_text"
          android:textSize="11sp"
          android:textStyle="bold"
          android:visibility="gone" />
      </FrameLayout>

      <TextView
        android:id="@+id/flowi_ring_title_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/flowi_widget_text"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/flowi_ring_caption_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:textColor="@color/flowi_widget_text_secondary"
        android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/flowi_ring_cell_4"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp">

        <ImageView
          android:id="@+id/flowi_ring_img_4"
          android:background="@drawable/flowi_ring_track_7"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no" />

        <TextView
          android:id="@+id/flowi_ring_center_4"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:autoSizeMaxTextSize="13sp"
          android:autoSizeMinTextSize="7sp"
          android:autoSizeTextType="uniform"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:maxLines="1"
          android:padding="9dp"
          android:textColor="@color/flowi_widget_text"
          android:textSize="12sp"
          android:textStyle="bold" />

        <Chronometer
          android:id="@+id/flowi_ring_chrono_4"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="@color/flowi_widget_text"
          android:textSize="11sp"
          android:textStyle="bold"
          android:visibility="gone" />
      </FrameLayout>

      <TextView
        android:id="@+id/flowi_ring_title_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/flowi_widget_text"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/flowi_ring_caption_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:textColor="@color/flowi_widget_text_secondary"
        android:textSize="9.5sp" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/flowi_signed_out"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginTop="12dp"
    android:fontFamily="sans-serif-medium"
    android:gravity="center"
    android:textColor="@color/flowi_widget_text_secondary"
    android:textSize="13sp"
    android:visibility="gone" />

  <include
    layout="@layout/flowi_action_grid"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="12dp"
    android:layout_weight="1" />
</LinearLayout>
