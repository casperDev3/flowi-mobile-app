    { "name": "trailing slash is ignored", "url": "https://app.flowi.com.ua/app/finance/", "expect": { "kind": "app", "route": "/(tabs)/explore", "match": "table" } },
    { "name": "encoded project id stays encoded", "url": "https://app.flowi.com.ua/app/p/a%20b/notes", "expect": { "kind": "app", "route": "/project/a%20b/notes", "projectId": "a b", "match": "table" } },
    { "name": "training member", "url": "https://app.flowi.com.ua/app/training/g1/members/42", "expect": { "kind": "app", "route": "/training/g1/member/42", "match": "table" } },
    { "name": "training program", "url": "https://app.flowi.com.ua/app/training/g1/programs/pr9", "expect": { "kind": "app", "route": "/training/g1/program/pr9", "match": "table" } },
    { "name": "menu with space", "url": "https://app.flowi.com.ua/app/menu?space=s1", "expect": { "kind": "app", "route": "/menu?space=s1", "match": "table" } },
    { "name": "legacy host still resolves", "url": "https://api.flowi.casperdev.site/app/p/p1/tasks?open=t7", "expect": { "kind": "app", "route": "/project/p1/tasks?open=t7", "projectId": "p1", "match": "table" } },
    { "name": "server web_link ?task= becomes mobile ?open=", "url": "https://app.flowi.com.ua/app/p/p1/board?task=t7", "expect": { "kind": "app", "route": "/project/p1/tasks?open=t7", "projectId": "p1", "match": "table" } },
    { "name": "personal task web_link ?task=", "url": "https://app.flowi.com.ua/app/tasks?task=t1", "expect": { "kind": "app", "route": "/(tabs)?open=t1", "match": "table" } },
    { "name": "meeting web_link ?meeting=", "url": "https://app.flowi.com.ua/app/meetings?meeting=m1", "expect": { "kind": "app", "route": "/calendar?open=m1", "match": "table" } },
    { "name": "server web_link to a page web lacks (team) -> project parent", "url": "https://app.flowi.com.ua/app/p/p1/team", "expect": { "kind": "app", "route": "/project/p1/overview", "projectId": "p1", "match": "parent" } },
    { "name": "admin requests web_link -> admin parent", "url": "https://app.flowi.com.ua/app/admin/requests", "expect": { "kind": "app", "route": "/admin-workspace", "match": "parent" } },
