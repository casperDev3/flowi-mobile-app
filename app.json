{
  "expo": {
    "name": "Flowi",
    "slug": "f-tracking-app",
    "version": "1.4.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "flowi",
      "ftrackingapp"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.flowi.mobile",
      "buildNumber": "2611261",
      "associatedDomains": [
        "applinks:app.flowi.com.ua",
        "webcredentials:app.flowi.com.ua"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.flowi.mobile"
        ]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#181818",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.flowi.mobile",
      "versionCode": 2611261,
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.flowi.com.ua",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "app.flowi.com.ua",
              "pathPrefix": "/app/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F1F1F3",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0E0E10"
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Flowi читає з Здоровʼя кроки, пульс і пульс спокою, сон і його фази, вагу, SpO₂ та дистанцію, щоб показувати їх у розділі «Здоровʼя».",
          "NSHealthUpdateUsageDescription": "Flowi не записує дані в Здоровʼя — лише читає.",
          "background": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Flowi використовує Face ID, щоб захистити ваші збережені дані входу."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flowi використовує камеру, щоб сканувати QR-наліпки на коробках і відкривати їхній вміст.",
          "microphonePermission": "Flowi записує звук зустрічі, лише коли ви натискаєте «Запис», щоб зберегти аудіо до цієї зустрічі.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flowi відкриває фото, щоб ви могли додати зображення коробок, речей і скріншоти до звернень.",
          "cameraPermission": "Flowi використовує камеру, щоб сфотографувати коробку чи річ і додати фото до її картки.",
          "microphonePermission": "Flowi записує звук зустрічі, лише коли ви натискаєте «Запис», щоб зберегти аудіо до цієї зустрічі."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Flowi записує звук зустрічі, лише коли ви натискаєте «Запис», щоб зберегти аудіо до цієї зустрічі."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@bacons/apple-targets",
      "./modules/flowi-ios-bridge/app.plugin.js",
      "./plugins/withSentryUploadToggle",
      "./plugins/withAndroidReleaseSigning",
      "@sentry/react-native/expo",
      "expo-quick-actions",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
