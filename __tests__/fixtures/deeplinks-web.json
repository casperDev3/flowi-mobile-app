  "cases": [
    { "name": "project task card, universal link", "url": "https://app.flowi.com.ua/app/p/p1/tasks?open=t7", "expect": { "kind": "app", "route": "/project/p1/tasks?open=t7", "projectId": "p1", "match": "table" } },
    { "name": "project root -> overview", "url": "https://app.flowi.com.ua/app/p/p1", "expect": { "kind": "app", "route": "/project/p1/overview", "projectId": "p1", "match": "table" } },
    { "name": "board has no mobile twin -> tasks", "url": "https://app.flowi.com.ua/app/p/p1/board", "expect": { "kind": "app", "route": "/project/p1/tasks", "projectId": "p1", "match": "table" } },
    { "name": "unknown project subpage -> nearest parent", "url": "https://app.flowi.com.ua/app/p/p1/brand-new-tab?x=1", "expect": { "kind": "app", "route": "/project/p1/overview", "projectId": "p1", "match": "parent" } },
    { "name": "unknown top-level page -> Today", "url": "https://app.flowi.com.ua/app/brand-new", "expect": { "kind": "app", "route": "/(tabs)/today", "match": "parent" } },
    { "name": "cabinet root -> Today", "url": "https://app.flowi.com.ua/app", "expect": { "kind": "app", "route": "/(tabs)/today", "match": "table" } },
