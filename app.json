{
  "expo": {
    "name": "Flowi",
    "slug": "f-tracking-app",
    "version": "1.4.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "flowi",
      "ftrackingapp"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.flowi.mobile",
      "buildNumber": "2611261",
      "associatedDomains": [
        "applinks:app.flowi.com.ua",
        "webcredentials:app.flowi.com.ua"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.flowi.mobile"
        ]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#181818",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.flowi.mobile",
      "versionCode": 2611261,
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.flowi.com.ua",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "app.flowi.com.ua",
              "pathPrefix": "/app/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F1F1F3",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0E0E10"
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Flowi reads steps, heart rate and resting heart rate, sleep and its stages, weight, SpO₂ and distance from Health to show them in the Health section.",
          "NSHealthUpdateUsageDescription": "Flowi does not write data to Health; it only reads it.",
          "background": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Flowi uses Face ID to protect your saved sign-in details."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flowi uses the camera to scan QR labels on boxes and to take photos of boxes and items.",
          "microphonePermission": "Flowi records meeting audio only when you tap “Record”, to save it to that meeting.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flowi opens your photos so you can attach pictures of boxes and items, and screenshots to feedback reports.",
          "cameraPermission": "Flowi uses the camera to scan QR labels on boxes and to take photos of boxes and items.",
          "microphonePermission": "Flowi records meeting audio only when you tap “Record”, to save it to that meeting."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Flowi records meeting audio only when you tap “Record”, to save it to that meeting."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@bacons/apple-targets",
      "./modules/flowi-ios-bridge/app.plugin.js",
      "./plugins/withSentryUploadToggle",
      "./plugins/withAndroidReleaseSigning",
      "@sentry/react-native/expo",
      "expo-quick-actions",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "uk": "./locales/uk.json"
    }
  }
}
