    { "name": "menu invite web link", "url": "https://app.flowi.com.ua/invite/menu?ws=https%3A%2F%2Fapi.flowi.com.ua&t=tok", "expect": { "kind": "invite", "route": "/menu-invite?ws=https%3A%2F%2Fapi.flowi.com.ua&t=tok", "match": "table" } },
    { "name": "training invite web link", "url": "https://app.flowi.com.ua/invite/training?ws=https%3A%2F%2Fapi.flowi.com.ua&g=g1&t=tok", "expect": { "kind": "invite", "route": "/training-invite?ws=https%3A%2F%2Fapi.flowi.com.ua&g=g1&t=tok", "match": "table" } },
    { "name": "legacy Cloud ws in an invite is canonicalised", "url": "https://app.flowi.com.ua/invite?ws=https%3A%2F%2Fapi.flowi.casperdev.site&p=p1&t=tok", "expect": { "kind": "invite", "route": "/invite?ws=https%3A%2F%2Fapi.flowi.com.ua&p=p1&t=tok", "match": "table" } },
    { "name": "legacy Cloud ws in a menu invite (scheme)", "url": "ftrackingapp://menu-invite?ws=https%3A%2F%2Fapi.flowi.casperdev.site&t=tok", "expect": { "kind": "invite", "route": "/menu-invite?ws=https%3A%2F%2Fapi.flowi.com.ua&t=tok", "match": "table" } },
    { "name": "self-hosted ws is left as is", "url": "https://app.flowi.com.ua/invite/training?ws=https%3A%2F%2Fflowi.example.org&g=g1&t=tok", "expect": { "kind": "invite", "route": "/training-invite?ws=https%3A%2F%2Fflowi.example.org&g=g1&t=tok", "match": "table" } },
    { "name": "cabinet join pages are invites too", "url": "https://app.flowi.com.ua/app/training/join?t=tok", "expect": { "kind": "invite", "route": "/training-invite?t=tok", "match": "table" } },
    { "name": "new scheme project invite", "url": "flowi://invite?ws=https%3A%2F%2Fapi.flowi.com.ua&p=p1&t=tok", "expect": { "kind": "invite", "route": "/invite?ws=https%3A%2F%2Fapi.flowi.com.ua&p=p1&t=tok", "match": "table" } },
    { "name": "legacy scheme project invite", "url": "ftrackingapp://invite?ws=https%3A%2F%2Fapi.flowi.com.ua&p=p1&t=tok", "expect": { "kind": "invite", "route": "/invite?ws=https%3A%2F%2Fapi.flowi.com.ua&p=p1&t=tok", "match": "table" } },
    { "name": "new scheme menu invite", "url": "flowi://menu-invite?ws=https%3A%2F%2Fapi.flowi.com.ua&t=tok", "expect": { "kind": "invite", "route": "/menu-invite?ws=https%3A%2F%2Fapi.flowi.com.ua&t=tok", "match": "table" } },
    { "name": "new scheme training invite", "url": "flowi://training-invite?ws=x&g=g1&t=tok", "expect": { "kind": "invite", "route": "/training-invite?ws=x&g=g1&t=tok", "match": "table" } },
    { "name": "registry push: project task (legacy scheme)", "url": "ftrackingapp://project/p1/task/t7", "expect": { "kind": "app", "route": "/project/p1/tasks?open=t7", "projectId": "p1", "match": "table" } },
    { "name": "registry push: project task (new scheme)", "url": "flowi://project/p1/task/t7", "expect": { "kind": "app", "route": "/project/p1/tasks?open=t7", "projectId": "p1", "match": "table" } },
    { "name": "scheme project section unknown to the registry", "url": "ftrackingapp://project/p1/notes", "expect": { "kind": "app", "route": "/project/p1/notes", "projectId": "p1", "match": "table" } },
    { "name": "registry push: meeting", "url": "flowi://meeting/m1", "expect": { "kind": "app", "route": "/calendar?open=m1", "match": "table" } },
    { "name": "registry push: invites", "url": "ftrackingapp://invites?invite=i1", "expect": { "kind": "app", "route": "/invites?invite=i1", "match": "table" } },
    { "name": "widget triple-slash link passes through", "url": "ftrackingapp:///time", "expect": null },
    { "name": "note capture passes through", "url": "ftrackingapp:///notes?capture=1", "expect": null },
    { "name": "google oauth return passes through", "url": "ftrackingapp://integrations/google?gcal=connected", "expect": null },
    { "name": "container QR passes through", "url": "ftrackingapp://c/ws1/abc", "expect": null },
    { "name": "foreign scheme ignored", "url": "javascript:alert(1)", "expect": null },
    { "name": "garbage ignored", "url": "not a url", "expect": null }
  ],
  "next": [
    { "input": "/app/p/p1/tasks?open=t7", "expect": "/app/p/p1/tasks?open=t7" },
